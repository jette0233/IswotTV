FLASK_ENV=development
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-urlsafe-base64
CORS_ORIGINS=http://localhost:5173
START_EMBEDDED_SIGNER=false

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=chaoxing
MYSQL_PASSWORD=replace-me
MYSQL_DB=chaoxing
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

MQ_TTL_SECONDS=1200
PRODUCER_HEARTBEAT_TIMEOUT=15

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
TLS_CERT_PATH=./deploy/tls/fullchain.pem
TLS_KEY_PATH=./deploy/tls/privkey.pem
BACKUP_ENCRYPTION_KEY=replace-with-a-long-random-value
BACKUP_REMOTE=remote:chaoxing-backups
WORKER_CONCURRENCY=20
WORKER_LEASE_SECONDS=30
